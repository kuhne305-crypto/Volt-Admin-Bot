# ============================
# VOLT ADMIN - Umgebungsvariablen
# In Railway unter diesem Service als "Variables" eintragen
# (lokal: diese Datei zu ".env" kopieren und ausfüllen)
# ============================

# Bot-Token dieses Bots aus dem Discord Developer Portal
DISCORD_TOKEN=

# Server-ID, auf dem der Bot laufen soll (Rechtsklick auf Server -> ID kopieren)
GUILD_ID=

# Komma-getrennte User-IDs, die IMMER vollen Zugriff haben und nie vom
# Anti-Nuke-System gesperrt werden können (z.B. deine eigene ID + Co-Owner)
OWNER_IDS=

# Anti-Nuke Einstellungen
ANTINUKE_THRESHOLD=5
ANTINUKE_WINDOW_SECONDS=15
