# Token aus dem Discord Developer Portal (Bot niemals öffentlich teilen!)
DISCORD_TOKEN=

# Server-ID, auf dem der Bot laufen soll (Rechtsklick auf Server -> ID kopieren)
GUILD_ID=

# Komma-getrennte User-IDs, die IMMER vollen Zugriff haben und nie vom Anti-Nuke-System
# gesperrt werden können (z.B. deine eigene ID + ggf. Co-Owner)
OWNER_IDS=

# Kanal-ID, in den Sicherheits-Logs & Setup-Logs gepostet werden (leer lassen -> wird
# beim ersten Start automatisch als #admin-logs angelegt)
LOG_CHANNEL_ID=

# Anti-Nuke Einstellungen
ANTINUKE_THRESHOLD=5
ANTINUKE_WINDOW_SECONDS=15
